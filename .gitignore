# Rust build output
target/

# Local runtime state
data/
.local/
.secrets/
config.local.toml

# Environment files; keep the checked-in template
.env
.env.*
!.env.example

# Local database files and SQLite sidecars
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
